PORT=5002
NODE_ENV=development

# JWT
JWT_SECRET=cambia_este_valor_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# Base de datos (PostgreSQL / Supabase); las tablas viven en el esquema mechanicia
DATABASE_URL=postgresql://usuario:password@host:5432/postgres

# Google Gemini (plan gratuito): crea la clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_gemini_api_key_aqui
# Modelos opcionales en orden de preferencia (por defecto gemini-3.6-flash y, si está saturado, gemini-3.5-flash-lite)
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
